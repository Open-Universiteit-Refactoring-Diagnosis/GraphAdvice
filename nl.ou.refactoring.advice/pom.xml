<project
	xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<name>Open Universiteit Refactoring Advice through Knowledge Graphs</name>
	<description>A software component for generating refactoring advices by
		assembling a refactoring in a graph and converting it to a
		human-readable advice.</description>
	<properties>
		<maven.compiler.release>${maven.compiler.version}</maven.compiler.release>
	</properties>
	
	<artifactId>nl.ou.refactoring.advice</artifactId>

    <parent>
        <groupId>nl.ou.refactoring.advice</groupId>
        <artifactId>solution</artifactId>
        <version>${nl.ou.refactoring.advice.version}</version>
    </parent>

	<packaging>eclipse-plugin</packaging>

	<dependencies>
		<dependency>
			<!-- Unit testing -->
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter</artifactId>
			<version>6.1.3</version>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.eclipse.tycho</groupId>
				<artifactId>target-platform-configuration</artifactId>
				<configuration>
					<!-- include the pom dependencies above in the OSGi resolution so testCompile sees JUnit -->
					<pomDependencies>consider</pomDependencies>
				</configuration>
			</plugin>
		</plugins>
	</build>

	<profiles>
		<profile>
			<id>github</id>
			<repositories>
				<repository>
					<id>maven</id>
					<url>https://repo1.maven.org/maven2</url>
				</repository>
				<repository>
					<id>central</id>
					<url>https://repo.maven.apache.org/maven2</url>
				</repository>
				<repository>
					<id>github</id>
					<url>
						https://maven.pkg.github.com/Open-Universiteit-Refactoring-Diagnosis/GraphAdvice
					</url>
					<snapshots>
						<enabled>true</enabled>
					</snapshots>
				</repository>
			</repositories>
		</profile>
	</profiles>
	<distributionManagement>
		<repository>
			<id>github</id>
			<name>GitHub Packages</name>
			<url>
				https://maven.pkg.github.com/Open-Universiteit-Refactoring-Diagnosis/GraphAdvice
			</url>
		</repository>
	</distributionManagement>
</project>